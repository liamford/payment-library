%% Current state. Sources: business API, verification stack, invitation/payment handlers. Verified 2026-09-13.
flowchart TD
    subgraph Business["Business"]
        B1[Register<br/>ABN validated,<br/>PENDING_APPROVAL] --> B2[Admin approves]
        B2 --> B3[Invite staff<br/>vevo_requested=true<br/>paid_by_business=false<br/>no credit reserved,<br/>SES invitation email sent]
    end

    subgraph Applicant["Applicant"]
        A1[Receives email<br/>clicks invite link] --> A2[Sign up / Sign in]
        A2 --> A3[Fill application<br/>personal details, address,<br/>identity docs, passport details]
        A3 --> A4[Upload docs + selfie]
        A4 --> A5[Pay<br/>standard pricing + VEVO addon]
        A5 --> A6[Submit]
    end

    subgraph Pipeline["Verification Pipeline"]
        F[Prepare Evidence<br/>Rekognition face compare<br/>Name chain, tier]
        G[Adjudicate<br/>Bedrock Claude Sonnet 4.6]
        H{Decision?}
        I[Store Result]
        J[Check VEVO<br/>SOAP DHA work entitlement]
        K{VEVO error?}
        L[SubmitToACIC<br/>SOAP police check]
        M[Poll ACIC<br/>every 24h, max 90d]
        N{ACIC result?}
        O[StoreACICResult]
        P[MergeResults<br/>pass-through]
        DG{CheckDisputeGate}
        Q1[Generate Police Check Certificate<br/>prefix P]
        Q2[Generate VEVO Certificate<br/>prefix V<br/>requires VEVO SUCCEEDED]
    end

    subgraph Result["Result"]
        DCO[Open dispute window<br/>5m sandbox / 48h prod<br/>applicant sees DCO detail; certificates and business alert held]
        DCO_close[Waive, expire, withdraw,<br/>or admin resolve]
        R_result[Email both certificate PDFs<br/>+ SMS to applicant<br/>RESULT_APPROVED template]
        R_biz[RESULT_BUSINESS_ALERT<br/>email to employer dashboard]
        R_review[MANUAL_REVIEW notice<br/>to applicant + employer]
    end

    B3 -.-> A1
    A6 --> SQ[Submission SQS → workflow-trigger] --> F --> G --> H
    H -->|OK| I
    H -->|NEEDS_REVIEW| R_review
    I --> J --> K
    K -->|ERROR / UNAVAILABLE| R_review
    K -->|SUCCEEDED / NOT_APPLICABLE| L
    L --> M --> N
    N -->|NDCO/DCO| O --> P --> DG
    DG -->|NDCO| Q1 --> Q2 --> R_result --> R_biz
    DG -->|DCO| DCO --> DCO_close --> Q1
    DG -->|timeout / non-DCO| Q1
    N -->|timeout >= 90d| P --> DG
    N -->|POLLFAILED/REFERRED| M

    style DG fill:#6C5CE7,color:#fff
    style DCO fill:#D63031,color:#fff
    style DCO_close fill:#FDCB6E,color:#333
    style Q1 fill:#FDCB6E,color:#333
    style Q2 fill:#E17055,color:#fff
    style G fill:#6C5CE7,color:#fff
    style J fill:#0984E3,color:#fff
    style K fill:#D63031,color:#fff
    style R_result fill:#00B894,color:#fff
    style R_biz fill:#0984E3,color:#fff
    style R_review fill:#D63031,color:#fff
