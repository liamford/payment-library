%% Current state. Source: infra/lambda/verification/adjudicate/index.ts. Verified 2026-09-13.
flowchart TD
    LLM[LLM responds] --> Success{Valid?}

    Success -->|guardrail/timeout<br/>malformed/unexpected| Errors
    Success -->|yes| Eval

    subgraph Eval["LLM EVALUATES (4 dimensions)"]
        direction LR
        L1["Authenticity<br/>pass/concern"]
        L2["Face match<br/>pass/concern"]
        L3["Data consistency<br/>pass/concern<br/>includes name chain"]
        L4["Tier coverage<br/>pass/concern"]
    end

    Eval -->|OK or NEEDS_REVIEW| Overrides

    subgraph Errors["SYSTEM ERRORS → NEEDS_REVIEW"]
        direction LR
        E1["Guardrail block<br/>no retry"]
        E2["Timeout<br/>+ fallback retry"]
        E3["Malformed output<br/>+ fallback retry"]
        E4["Evidence too large<br/>>2.8MB image, >15MB total, or token budget"]
    end

    subgraph Overrides["4 OVERRIDE RULES (server-side, in order)"]
        direction LR
        R1["R1: Biometric fail<br/>OK→NR if sim<90%"]
        R2["R2: Rescue flip<br/>NR→OK if sim≥98%"]
        R3["R3: Guardian consent<br/>OK→NR if missing"]
        R4["R4: Stealth minor<br/>OK→NR if DOB under 18"]
    end

    Overrides --> Result{Result?}

    Result -->|OK| FinalOK["OK → ACIC police check"]
    Result -->|NR| FinalNR["NEEDS_REVIEW → manual review"]

    style Errors fill:#D63031,color:#fff
    style Eval fill:#fff3e0,color:#000
    style Overrides fill:#E17055,color:#fff
    style FinalOK fill:#00B894,color:#fff
    style FinalNR fill:#D63031,color:#fff
