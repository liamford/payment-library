%% Current state. Sources: close-dispute-window and delivery handlers, monitoring stack. Verified 2026-09-13.
flowchart TD
    subgraph Triggers["Close Triggers"]
        T1[Applicant waive]
        T2[Hourly sweep finds expired window]
        T3[Applicant withdraw]
        T4[Admin resolve<br/>ORIGINAL_STANDS or AMENDED]
    end

    subgraph Finalise["close-dispute-window"]
        F1[Select original or corrected outcome]
        F2[Mint certificate identity<br/>and generate PDF when applicable]
        F3[Transition through DISPUTE_WINDOW_CLOSED]
        F4[Mark application COMPLETED]
        F5[Create delivery messages]
        F6[Append audit event]
    end

    subgraph Delivery["Dispute Delivery Queue"]
        Q1[SQS servo-env-dispute-delivery]
        Q2[deliver-dispute-outcome]
        Q3[SES templated email]
        Q4[Delivery marker on application]
        Q5[DLQ]
        Q6[deliver-dispute-outcome-dlq]
    end

    subgraph Monitoring["Monitoring"]
        M1[Metric Dispute.DeliveryFailed]
        M2[Metric Dispute.WindowOpen]
        M3[Alarm dispute-delivery-failed-p1]
        M4[Alarm dispute-window-stuck-p2]
        M5[Admin notification]
    end

    T1 --> F1
    T2 --> F1
    T3 --> F1
    T4 --> F1
    F1 --> F2 --> F3 --> F4 --> F5 --> Q1
    F1 --> F6
    Q1 --> Q2 --> Q3 --> Q4
    Q2 -->|failed after retries| Q5 --> Q6 --> M5
    Q2 -->|send or enqueue failure| M1 --> M3
    T2 --> M2 --> M4

    subgraph EvidenceOps["Evidence Scan"]
        E1[S3 ObjectCreated<br/>disputes/id/quarantine/file]
        E2[scan-dispute-evidence]
        E3[Accepted evidence key]
        E4[Rejected evidence email]
        E5[Audit scan or rejection]
    end

    E1 --> E2
    E2 -->|clean| E3
    E2 -->|rejected| E4
    E2 --> E5

    style F1 fill:#6C5CE7,color:#fff
    style F4 fill:#00B894,color:#fff
    style Q5 fill:#D63031,color:#fff
    style M3 fill:#D63031,color:#fff
    style E2 fill:#FDCB6E,color:#333
