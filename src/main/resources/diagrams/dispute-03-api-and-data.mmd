flowchart LR
    subgraph Customer["Customer API"]
        C1[POST /v1/applications/id/dispute<br/>raise-dispute]
        C2[GET /v1/applications/id/dispute<br/>get-dispute]
        C3[POST /v1/applications/id/dispute/messages<br/>add-dispute-message]
        C4[POST /v1/applications/id/dispute/waive<br/>waive-dispute-window]
        C5[POST /v1/applications/id/dispute/withdraw<br/>withdraw-dispute]
    end

    subgraph Admin["Admin API"]
        A1[GET /admin/v1/disputes/open<br/>list-open-disputes]
        A2[GET /admin/v1/applications/id/dispute<br/>get-dispute]
        A3[POST /admin/v1/applications/id/dispute/replies/draft<br/>draft-dispute-reply]
        A4[POST /admin/v1/applications/id/dispute/replies/messageId/send<br/>send-dispute-reply]
        A5[PUT /admin/v1/applications/id/dispute/result<br/>update-dispute-result]
        A6[POST /admin/v1/applications/id/dispute/resolve<br/>resolve-dispute]
        A7[POST /admin/v1/applications/id/dispute/resend-delivery<br/>resend-dispute-delivery]
        A8[POST /admin/v1/applications/id/dispute/escalate<br/>escalate-dispute]
        A9[POST /admin/v1/applications/id/dispute/analyse-evidence<br/>analyse-dispute-evidence]
    end

    subgraph Data["DynamoDB Core Table"]
        D1[Application<br/>PK APP#id<br/>SK METADATA]
        D2[Dispute singleton<br/>PK APP#id<br/>SK DISPUTE]
        D3[Dispute messages<br/>PK APP#id<br/>SK DISPUTEMSG#timestamp#uuid]
        D4[GSI8 window queue<br/>WINDOW#OPEN<br/>deadline sorted]
        D5[GSI8 admin queue<br/>DISPUTE#OPEN<br/>status and raised time sorted]
        D6[Audit log items]
    end

    subgraph Evidence["Evidence Storage"]
        S1[S3 quarantine prefix<br/>disputes/id/quarantine/]
        S2[scan-dispute-evidence]
        S3[S3 accepted prefix<br/>disputes/id/]
    end

