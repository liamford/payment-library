%% Current state. Sources: business API, verification stack, invitation/payment handlers. Verified 2026-09-13.
flowchart TD
    subgraph Business["Business"]
        B1[Register<br/>ABN validated,<br/>PENDING_APPROVAL] --> B2[Admin approves]
        B2 --> B3[Invite staff<br/>no credit reserved,<br/>SES invitation email sent]
    end

    subgraph Applicant["Applicant"]
        A1[Receives email<br/>clicks invite link] --> A2[Sign up / Sign in]
        A2 --> A3[Fill application<br/>personal details, address,<br/>identity docs]
        A3 --> A4[Upload docs + selfie]
        A4 --> A5[Pay<br/>standard pricing]
        A5 --> A6[Submit]
    end

    subgraph Pipeline["Verification Pipeline"]
        F[Prepare Evidence<br/>Rekognition face compare<br/>Name chain, tier]
        G[Adjudicate<br/>Bedrock Claude Sonnet 4.6]
        H{Decision?}
        I[Store Result]
        J[SubmitToACIC<br/>SOAP police check]
        K[Poll ACIC<br/>every 24h, max 90d]
        L{ACIC result?}
        M[StoreACICResult]
        N[MergeResults<br/>pass-through]
        DG{CheckDisputeGate}
        O[Generate Police Check Certificate<br/>prefix P]
    end

    subgraph Result["Result"]
        DCO[Open dispute window<br/>5m sandbox / 48h prod<br/>applicant sees DCO detail; certificate and business alert held]
        DCO_close[Waive, expire, withdraw,<br/>or admin resolve]
        P_cert[Email police check certificate PDF<br/>+ SMS to applicant<br/>RESULT_APPROVED template]
        P_biz[RESULT_BUSINESS_ALERT<br/>email to employer dashboard]
        P_review[MANUAL_REVIEW notice<br/>to applicant + employer]
    end

    B3 -.-> A1
    A6 --> SQ[Submission SQS → workflow-trigger] --> F --> G --> H
    H -->|OK| I
    H -->|NEEDS_REVIEW| P_review
    I --> J --> K --> L
    L -->|NDCO/DCO| M --> N --> DG
    DG -->|NDCO| O --> P_cert --> P_biz
    DG -->|DCO| DCO --> DCO_close --> O
    DG -->|timeout / non-DCO| O
    L -->|timeout >= 90d| N --> DG
    L -->|POLLFAILED/REFERRED| K

    style DG fill:#6C5CE7,color:#fff
    style DCO fill:#D63031,color:#fff
    style DCO_close fill:#FDCB6E,color:#333
    style O fill:#FDCB6E,color:#333
    style G fill:#6C5CE7,color:#fff
    style B2 fill:#00B894,color:#fff
    style A5 fill:#0984E3,color:#fff
    style B3 fill:#E17055,color:#fff
    style P_cert fill:#00B894,color:#fff
    style P_biz fill:#0984E3,color:#fff
    style P_review fill:#D63031,color:#fff
